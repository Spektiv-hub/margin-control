# Margin Control — environment variables (THIS project / Vercel deployment only).
# Copy to .env.local for local dev. Never commit real values.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Inbox that receives applications
RECIPIENT_EMAIL=

# Sender address. Placeholder = Resend's test sender. Swap to a
# verified-domain address later (one-line change, no code edit).
FROM_EMAIL=onboarding@resend.dev
